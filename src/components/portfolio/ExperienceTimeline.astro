---
import { experiences, experienceGroup } from "../../data/portfolio";
import { formatPeriod } from "../../utils/period";
import ExperienceCard from "./ExperienceCard.astro";

const accentColor = "#38BFF7";
const periodBg = "#E8F4FF";
const groupPeriodLabel = formatPeriod(experienceGroup.period);
const groupToggleIds = experiences.map((exp) => exp.id).join(",");
---

<section class="relative mb-16 experience-timeline hidden lg:block w-full max-w-none">
  <h2
    class="text-4xl font-bold mb-1 -mt-5 -ml-6"
    style={`color: ${accentColor}`}
  >
    EXPERIENCES
  </h2>
  <p class="text-sm text-gray-500 dark:text-gray-400 mb-4 -ml-6">
    {experienceGroup.company} · {experienceGroup.role}
  </p>
  <div class="relative timeline-track">
    <div
      class="timeline-line absolute top-0 bottom-0 w-1"
      style={`background-color: ${accentColor}; box-shadow: 0 0 8px rgba(55, 190, 247, 0.45), 0 0 16px rgba(55, 190, 247, 0.35)`}
    />
    {
      groupPeriodLabel && (
        <div class="timeline-row mb-4">
          <button
            type="button"
            class="timeline-period-btn timeline-toggle-group inline-flex items-center px-3 py-1.5 rounded-full transition-all duration-300 cursor-pointer overflow-hidden"
            style={`background-color: ${periodBg}; color: #374151`}
            aria-label="Toggle all experiences"
            data-toggle-group={groupToggleIds}
          >
            <span class="text-xs font-extrabold whitespace-nowrap tracking-wide text-gray-900">
              {groupPeriodLabel}
            </span>
            <span
              class="toggle-icon absolute right-0 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full border-2 flex items-center justify-center bg-white"
              style={`border-color: ${accentColor}; box-shadow: 0 0 10px ${accentColor}73`}
            >
              <svg
                class="w-4 h-4"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                style={`color: ${accentColor}`}
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="4"
                  d="M12 4v16m8-8H4"
                />
              </svg>
            </span>
          </button>
        </div>
      )
    }
    <div class="timeline-items space-y-8">
      {
        experiences.map((exp, i) => (
          <ExperienceCard
            experience={exp}
            index={i}
            accentColor={exp.accentColor ?? accentColor}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="lg:hidden mb-12">
  <h2 class="text-3xl font-bold mb-1" style={`color: ${accentColor}`}>
    EXPERIENCES
  </h2>
  {
    groupPeriodLabel && (
      <p class="text-sm text-gray-500 dark:text-gray-400 mb-6">
        {experienceGroup.company} · {experienceGroup.role} · {groupPeriodLabel}
      </p>
    )
  }
  <div class="space-y-6">
    {
      experiences.map((exp, i) => (
        <div class="animate-fade-in" style={`animation-delay: ${i * 0.1}s`}>
          <div class="bg-white dark:bg-gray-800 rounded-lg p-5 shadow-sm">
            <h3 class="text-lg font-extrabold mb-1" style={`color: ${exp.accentColor ?? accentColor}`}>
              {exp.title}
            </h3>
            {
              exp.built && (
                <ul class="space-y-1 text-sm text-gray-700 dark:text-gray-300 list-none p-0 m-0">
                  {exp.built.slice(0, 3).map((item) => (
                    <li class="flex gap-2">
                      <span class="text-amber-500 dark:text-amber-400">•</span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )
            }
          </div>
        </div>
      ))
    }
  </div>
</section>
